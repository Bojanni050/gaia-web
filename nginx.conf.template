server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Same-origin proxies for Gaia's backends. None of Hermes, Hindsight, or
    # the cognition service send CORS headers (Hindsight's own OPTIONS
    # preflight 405s), so the browser calling them cross-origin is always
    # blocked. Routing everything through this same origin isn't a style
    # choice, it's the only way any of this works from a real browser.
    # Reachability requires gaia-web to share a Docker network with
    # gaia-hermes-proxy (for /api/hermes/); Hindsight and the cognition
    # service are reached directly over Tailscale, which any container on
    # this host can already route to.

    location /api/hermes/ {
        proxy_pass http://gaia-hermes-proxy/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
    }

    location /api/hindsight/ {
        proxy_pass http://100.64.144.93:8888/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location /api/cognition/ {
        proxy_pass http://100.64.144.93:8890/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # gaia-api is Tailscale-bound like Hindsight/cognition — reachable from
    # any container on this host — but unlike those two it requires Bearer
    # auth. The browser never holds the token: this proxy injects it,
    # exactly like gaia-hermes-proxy injects HERMES_AUTH_TOKEN toward
    # hermes-agent (docs/web-migration-plan.md §5's chosen auth model).
    # ${GAIA_API_TOKEN_WEB} is substituted from the container's environment
    # at startup (this file is a template — see Dockerfile/deploy.yml);
    # nginx's own $-prefixed runtime variables below (no curly braces) are
    # untouched by that substitution.
    location /api/gaia/ {
        proxy_pass http://100.64.144.93:8891/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization "Bearer ${GAIA_API_TOKEN_WEB}";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
